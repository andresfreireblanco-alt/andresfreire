---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

// 1. Recoge automáticamente las imágenes de cada sección
const globFotografiaHorizontales = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/fotografia/horizontales/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const globFotografiaVerticales = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/fotografia/verticales/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

// Respaldo con las fotos generales de src/assets/ mientras las carpetas nuevas estén vacías
const globFotografiaGeneral = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const globVideoclips = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/videoclips/fotogramas/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const globCortometrajes = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/cortometrajes/fotogramas/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const globMediaOnline = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/media-online/fotogramas/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const globBio = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/bio/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

// Para Música lee tanto src/assets/musica/ como las carátulas de public/portadas/
const globMusicaAssets = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/musica/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const globMusicaPublic = import.meta.glob('/public/portadas/*.{jpg,jpeg,png,webp}');

const aRutas = (globObj: Record<string, { default: ImageMetadata }>) =>
  Object.values(globObj).map((mod) => mod.default.src);

const modsGeneral = Object.values(globFotografiaGeneral).map((mod) => mod.default);
const todasGenerales = modsGeneral.map((img) => img.src);
const generalHorizontales = modsGeneral
  .filter((img) => img.width >= img.height)
  .map((img) => img.src);
const generalVerticales = modsGeneral
  .filter((img) => img.height > img.width)
  .map((img) => img.src);

const seleccionHorizontales = aRutas(globFotografiaHorizontales);
const seleccionVerticales = aRutas(globFotografiaVerticales);

const fotosFotoDesktop =
  seleccionHorizontales.length > 0
    ? seleccionHorizontales
    : generalHorizontales.length > 0
      ? generalHorizontales
      : todasGenerales;

const fotosFotoMovil =
  seleccionVerticales.length > 0
    ? seleccionVerticales
    : generalVerticales.length > 0
      ? generalVerticales
      : todasGenerales;

const fotosVideoclips = aRutas(globVideoclips);
const fotosCortos = aRutas(globCortometrajes);
const fotosMediaOnline = aRutas(globMediaOnline);
const fotosBio = aRutas(globBio);
const fotosMusica = [
  ...aRutas(globMusicaAssets),
  ...Object.keys(globMusicaPublic).map((ruta) => ruta.replace('/public', '')),
];

const respaldo = todasGenerales.length > 0 ? todasGenerales : fotosMusica;
const respaldoDesktop = fotosFotoDesktop.length > 0 ? fotosFotoDesktop : respaldo;

// Datos flotantes para la sección Bio
const contactoBio = [
  {
    id: 'correo',
    texto: 'andresfreireblanco@gmail.com',
    tipo: 'email',
    valor: 'andresfreireblanco@gmail.com',
  },
  {
    id: 'instagram',
    texto: '@andres__freire ↗',
    tipo: 'enlace',
    valor: 'https://www.instagram.com/andres__freire',
  },
];

const categorias = [
  {
    id: 'fotografia',
    nombre: 'Fotografía',
    url: '/fotografia',
    flotante: false,
    bioFlotante: false,
    imagenes: fotosFotoMovil.length > 0 ? fotosFotoMovil : respaldo,
    imagenesDesktop: respaldoDesktop,
  },
  {
    id: 'videoclip',
    nombre: 'Videoclip',
    url: '/videoclip',
    flotante: false,
    bioFlotante: false,
    imagenes: fotosVideoclips.length > 0 ? fotosVideoclips : respaldo,
  },
  {
    id: 'musica',
    nombre: 'Música',
    url: '/musica',
    flotante: true,
    bioFlotante: false,
    imagenes: fotosMusica.length > 0 ? fotosMusica : respaldo,
  },
  {
    id: 'cortometrajes',
    nombre: 'Cortometrajes',
    url: '/cortometrajes',
    flotante: false,
    bioFlotante: false,
    imagenes: fotosCortos.length > 0 ? fotosCortos : respaldo,
  },
  {
    id: 'media-online',
    nombre: 'Media online',
    url: '/media-online',
    flotante: false,
    bioFlotante: false,
    imagenes: fotosMediaOnline.length > 0 ? fotosMediaOnline : respaldo,
  },
  {
    id: 'bio',
    nombre: 'Bio',
    url: '/bio',
    flotante: false,
    bioFlotante: true,
    imagenes: fotosBio,
  },
];

const listaInicial = respaldoDesktop;
const imagenInicial =
  listaInicial.length > 0
    ? listaInicial[Math.floor(Math.random() * listaInicial.length)]
    : '';

const categoriasJSON = JSON.stringify(categorias);
const contactoBioJSON = JSON.stringify(contactoBio);
const muescas = Array.from({ length: 48 }, (_, i) => i * (360 / 48));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Andrés Freire</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="dial-cuerpo">
    <!-- Cortina de carga centrada únicamente al recargar -->
    <div id="inicio-pantalla-carga" class="inicio-pantalla-carga" aria-hidden="true">
      <div class="inicio-carga-pista">
        <div id="inicio-carga-progreso" class="inicio-carga-progreso"></div>
      </div>
    </div>
    <script is:inline>
      if (window.__navegacionInterna) {
        var cortina = document.getElementById('inicio-pantalla-carga');
        if (cortina) cortina.style.display = 'none';
      }
    </script>

    <main id="dial-pantalla" class="dial-pantalla" tabindex="0">
      <!-- Lienzo de imágenes (a sangre, portadas flotantes en Música o contacto flotante en Bio) -->
      <div id="dial-fondo-contenedor" class="dial-fondo-contenedor">
        {imagenInicial && (
          <img
            id="dial-fondo-a"
            src={imagenInicial}
            alt="Andrés Freire"
            class="dial-fondo-img visible"
          />
        )}
        <img
          id="dial-fondo-b"
          src=""
          alt=""
          class="dial-fondo-img"
          aria-hidden="true"
        />
        <div id="dial-veladura" class="dial-veladura" aria-hidden="true"></div>

        <!-- Contenedor de portadas cuadradas que viajan por la pantalla en Música -->
        <div id="dial-musica-flotante" class="dial-musica-flotante" aria-hidden="true"></div>

        <!-- Contenedor de correo e Instagram flotantes con rastro en cascada en Bio -->
        <div id="dial-bio-flotante" class="dial-bio-flotante" aria-hidden="true">
          <div id="dial-bio-rastro" class="dial-bio-rastro" aria-hidden="true"></div>
          <div id="dial-bio-activos" class="dial-bio-activos"></div>
        </div>
      </div>

      <!-- Logo en la esquina superior izquierda -->
      <header class="dial-cabecera">
        <a href="/" class="dial-marca" aria-label="Andrés Freire">
          <img src="/logo.png" alt="Andrés Freire" class="dial-logo" />
        </a>
      </header>

      <!-- Dial giratorio en el borde derecho -->
      <nav class="dial-zona-derecha" aria-label="Selector de secciones">
        <div class="dial-indicador-fijo" aria-hidden="true">
          <span class="dial-linea-aguja"></span>
        </div>

        <div id="dial-rueda" class="dial-rueda">
          <div id="dial-anillo-muescas" class="dial-anillo-muescas" aria-hidden="true">
            {muescas.map((angulo, idx) => (
              <span
                class:list={['dial-muesca', { mayor: idx % 4 === 0 }]}
                style={`transform: rotate(${angulo}deg);`}
              ></span>
            ))}
          </div>

          <ul class="dial-lista">
            {categorias.map((cat, idx) => (
              <li
                class:list={['dial-radio', { activo: idx === 0 }]}
                data-index={idx}
                style={`transform: rotate(${-idx * 22}deg);`}
              >
                <a
                  href={cat.url}
                  class="dial-opcion"
                  data-index={idx}
                  aria-current={idx === 0 ? 'page' : undefined}
                >
                  <span class="dial-num">0{idx + 1}</span>
                  <span class="dial-texto">{cat.nombre}</span>
                  <span class="dial-flecha" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </main>

    <script id="dial-datos-json" type="application/json" set:html={categoriasJSON}></script>
    <script id="dial-bio-json" type="application/json" set:html={contactoBioJSON}></script>

    <style>
      .dial-cuerpo {
        margin: 0;
        overflow: hidden;
      }

      /* Cortina de carga centrada al recargar */
      .inicio-pantalla-carga {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background-color: #f8f2ef;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 1;
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
        pointer-events: auto;
      }

      .inicio-pantalla-carga.oculta {
        opacity: 0;
        pointer-events: none;
      }

      .inicio-carga-pista {
        width: min(180px, 42vw);
        height: 1px;
        background-color: rgba(17, 17, 17, 0.14);
        overflow: hidden;
      }

      .inicio-carga-progreso {
        width: 100%;
        height: 100%;
        background-color: #111111;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .inicio-carga-progreso.llena {
        transform: scaleX(1);
      }

      .dial-pantalla {
        --dial-bg: #111111;
        --dial-fg: #f8f2ef;
        --dial-muesca: rgba(248, 242, 239, 0.24);
        --dial-muesca-mayor: rgba(248, 242, 239, 0.5);
        --dial-borde: rgba(248, 242, 239, 0.24);

        --logo-fg: #f8f2ef;
        --logo-filter: brightness(0) invert(1);

        position: relative;
        width: 100vw;
        height: 100dvh;
        overflow: hidden;
        outline: none;
        user-select: none;
        background-color: var(--dial-bg);
        color: var(--dial-fg);
        transition:
          background-color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
          color 0.55s ease;
      }

      /* Modo papel #f8f2ef para Música y Bio */
      .dial-pantalla.modo-claro {
        --dial-bg: #f8f2ef;
        --dial-fg: #111111;
        --dial-muesca: rgba(17, 17, 17, 0.16);
        --dial-muesca-mayor: rgba(17, 17, 17, 0.42);
        --dial-borde: rgba(17, 17, 17, 0.16);

        --logo-fg: #111111;
        --logo-filter: none;
      }

      /* Contraste dinámico cuando la zona del logo o del dial cae sobre fondo claro */
      .dial-pantalla.logo-sobre-claro {
        --logo-fg: #111111;
        --logo-filter: none;
      }

      .dial-pantalla.dial-sobre-claro {
        --dial-fg: #111111;
        --dial-muesca: rgba(17, 17, 17, 0.18);
        --dial-muesca-mayor: rgba(17, 17, 17, 0.44);
        --dial-borde: rgba(17, 17, 17, 0.18);
      }

      /* Capas de imagen */
      .dial-fondo-contenedor {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .dial-fondo-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.03);
        transition:
          opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
          transform 1s cubic-bezier(0.22, 1, 0.36, 1);
        pointer-events: none;
      }

      .dial-fondo-img.visible {
        opacity: 1;
        transform: scale(1);
      }

      .dial-veladura {
        position: absolute;
        inset: 0;
        background: radial-gradient(
          circle at 35% 50%,
          rgba(17, 17, 17, 0.14) 0%,
          rgba(17, 17, 17, 0.44) 100%
        );
        opacity: 1;
        transition: opacity 0.65s ease;
        pointer-events: none;
      }

      .dial-pantalla.modo-claro .dial-veladura {
        opacity: 0;
      }

      /* Portadas flotantes que viajan por la pantalla en Música */
      .dial-musica-flotante {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .dial-musica-flotante.visible {
        opacity: 1;
      }

      :global(.flotante-slot) {
        position: absolute;
        left: 0;
        top: 0;
        width: var(--size);
        aspect-ratio: 1 / 1;
        touch-action: none;
        pointer-events: none;
        will-change: transform;
      }

      .dial-musica-flotante.visible :global(.flotante-slot) {
        pointer-events: auto;
      }

      :global(.flotante-carta) {
        width: 100%;
        height: 100%;
        opacity: 0;
        transform: scale(0.96);
        transition:
          opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms),
          transform 0.55s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms);
      }

      .dial-musica-flotante.visible :global(.flotante-carta) {
        opacity: 1;
        transform: scale(1);
      }

      :global(.flotante-slot.arrastrando .flotante-carta) {
        transition: opacity 0.3s ease, transform 0.2s ease;
        transform: scale(1.03);
      }

      :global(.flotante-carta img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        pointer-events: none;
        box-shadow: 0 12px 28px rgba(17, 17, 17, 0.08);
        transition: box-shadow 0.3s ease;
      }

      :global(.flotante-slot.arrastrando .flotante-carta img) {
        box-shadow: 0 20px 40px rgba(17, 17, 17, 0.14);
      }

      /* Elementos flotantes de Bio (correo e Instagram) con rastro multiplicado */
      .dial-bio-flotante {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .dial-bio-flotante.visible {
        opacity: 1;
      }

      .dial-bio-rastro,
      .dial-bio-activos {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      :global(.bio-slot) {
        position: absolute;
        left: 0;
        top: 0;
        touch-action: none;
        pointer-events: none;
        will-change: transform;
        cursor: grab;
      }

      .dial-bio-flotante.visible :global(.bio-slot) {
        pointer-events: auto;
      }

      :global(.bio-slot.arrastrando) {
        cursor: grabbing;
      }

      :global(.bio-pildora),
      :global(.bio-rastro-clon) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.85rem;
        background-color: #f8f2ef;
        border: 1px solid rgba(17, 17, 17, 0.18);
        color: #111111;
        font-family: inherit;
        font-size: clamp(13.5px, 1.15vw, 15.5px);
        font-weight: 400;
        letter-spacing: -0.015em;
        line-height: 1.2;
        white-space: nowrap;
      }

      :global(.bio-pildora) {
        opacity: 0;
        transform: scale(0.96);
        box-shadow: 0 6px 20px rgba(17, 17, 17, 0.05);
        transition:
          opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms),
          transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms),
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .dial-bio-flotante.visible :global(.bio-pildora) {
        opacity: 1;
        transform: scale(1);
      }

      :global(.bio-slot:hover .bio-pildora) {
        border-color: rgba(17, 17, 17, 0.42);
      }

      :global(.bio-slot.arrastrando .bio-pildora) {
        border-color: #111111;
        box-shadow: 0 12px 28px rgba(17, 17, 17, 0.1);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      :global(.bio-estado-copia) {
        font-size: 11px;
        letter-spacing: 0.01em;
        color: #111111;
        opacity: 0.52;
      }

      :global(.bio-rastro-clon) {
        position: absolute;
        left: 0;
        top: 0;
        pointer-events: none;
        will-change: transform, opacity;
        border-color: rgba(17, 17, 17, 0.13);
        box-shadow: 0 2px 10px rgba(17, 17, 17, 0.03);
        transition:
          opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      :global(.bio-rastro-clon.desvanecer) {
        opacity: 0 !important;
      }

      /* Cabecera con logo */
      .dial-cabecera {
        position: relative;
        z-index: 4;
        padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1.75rem, 4.5vw, 3.75rem);
        pointer-events: none;
      }

      .dial-marca {
        pointer-events: auto;
        display: inline-flex;
        align-items: center;
        color: var(--logo-fg);
        transition: opacity 0.2s ease, color 0.45s ease;
      }

      .dial-marca:hover {
        opacity: 0.7;
      }

      .dial-logo {
        display: block;
        width: clamp(96px, 9.5vw, 132px);
        max-width: 100%;
        height: auto;
        object-fit: contain;
        filter: var(--logo-filter);
        transition: filter 0.45s ease;
      }

      /* Dial giratorio en el borde derecho */
      .dial-zona-derecha {
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        z-index: 5;
        width: 350px;
        height: 620px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        pointer-events: none;
      }

      .dial-indicador-fijo {
        position: absolute;
        right: 294px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        z-index: 6;
      }

      .dial-linea-aguja {
        display: block;
        width: 18px;
        height: 1px;
        background-color: var(--dial-fg);
        transition: background-color 0.45s ease;
      }

      .dial-rueda {
        position: absolute;
        right: -280px;
        top: 50%;
        width: 560px;
        height: 560px;
        margin-top: -280px;
        border-radius: 50%;
        border: 1px solid var(--dial-borde);
        transition: border-color 0.45s ease;
        pointer-events: auto;
      }

      .dial-anillo-muescas {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
        pointer-events: none;
      }

      .dial-muesca {
        position: absolute;
        left: 0;
        top: 50%;
        width: 6px;
        height: 1px;
        background-color: var(--dial-muesca);
        transform-origin: 280px center;
        transition: background-color 0.45s ease;
      }

      .dial-muesca.mayor {
        width: 11px;
        background-color: var(--dial-muesca-mayor);
      }

      .dial-lista {
        list-style: none;
        margin: 0;
        padding: 0;
        position: absolute;
        inset: 0;
      }

      .dial-radio {
        position: absolute;
        right: 50%;
        top: 50%;
        width: 280px;
        margin-top: -18px;
        height: 36px;
        transform-origin: right center;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding-left: 22px;
        transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .dial-opcion {
        display: inline-flex;
        align-items: baseline;
        gap: 0.55rem;
        color: var(--dial-fg);
        opacity: 0.42;
        transition:
          opacity 0.35s ease,
          color 0.45s ease,
          transform 0.25s ease;
        white-space: nowrap;
      }

      .dial-opcion:hover {
        color: var(--dial-fg);
        opacity: 0.85;
      }

      .dial-radio.activo .dial-opcion {
        opacity: 1;
      }

      .dial-radio.activo .dial-opcion:hover {
        transform: translateX(3px);
      }

      .dial-num {
        font-size: 10.5px;
        letter-spacing: 0.03em;
        opacity: 0.65;
      }

      .dial-texto {
        font-size: 20px;
        font-weight: 400;
        letter-spacing: -0.02em;
      }

      .dial-radio.activo .dial-texto {
        font-weight: 500;
      }

      .dial-flecha {
        font-size: 14px;
        opacity: 0;
        transform: translate(-4px, 2px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .dial-radio.activo .dial-flecha {
        opacity: 0.9;
        transform: translate(0, 0);
      }

      @media (max-width: 768px) {
        .dial-logo {
          width: 92px;
        }

        .dial-zona-derecha {
          width: 240px;
          height: 440px;
        }

        .dial-indicador-fijo {
          right: 202px;
        }

        .dial-rueda {
          right: -190px;
          width: 380px;
          height: 380px;
          margin-top: -190px;
        }

        .dial-muesca {
          transform-origin: 190px center;
        }

        .dial-radio {
          width: 190px;
          padding-left: 16px;
        }

        .dial-texto {
          font-size: 16.5px;
        }

