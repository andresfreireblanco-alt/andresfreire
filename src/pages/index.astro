            carta.appendChild(img);
            slot.appendChild(carta);
            musicaFlotante.appendChild(slot);

            const rect = slot.getBoundingClientRect();
            const sizePx = rect.width || (esMovil ? 96 : 150);
            const pctX = (esMovil ? slotCfg.mx : slotCfg.x) + (Math.random() - 0.5) * 3;
            const pctY = (esMovil ? slotCfg.my : slotCfg.y) + (Math.random() - 0.5) * 3;

            const angulo = anguloBase + i * pasoAngulo + (Math.random() - 0.5) * 0.4;
            const velocidad = 3.2 + Math.random() * 2.2;

            const item = {
              el: slot,
              size: sizePx,
              x: (pctX / 100) * ancho,
              y: (pctY / 100) * alto,
              vx: Math.cos(angulo) * velocidad,
              vy: Math.sin(angulo) * velocidad,
              dragging: false,
            };

            aplicarPosicionItem(item);
            conectarArrastre(item);
            itemsFlotantes.push(item);
          });

          void musicaFlotante.offsetWidth;
          musicaFlotante.classList.add('visible');
          iniciarMotorViaje();
        };

        // --- Motor flotante + rastro en cascada para Bio ---
        const limpiarTimersRastro = () => {
          timersRastro.forEach((id) => clearTimeout(id));
          timersRastro = [];
        };

        const detenerMotorBio = () => {
          if (rafBio) {
            cancelAnimationFrame(rafBio);
            rafBio = null;
          }
        };

        const aplicarPosicionBio = (item) => {
          const halfW = item.width / 2;
          const halfH = item.height / 2;
          item.el.style.transform = `translate3d(${item.x - halfW}px, ${item.y - halfH}px, 0)`;
        };

        const iniciarMotorBio = () => {
          detenerMotorBio();
          ultimoTiempoBio = performance.now();

          const paso = (ahora) => {
            const dt = Math.min((ahora - ultimoTiempoBio) / 1000, 0.05);
            ultimoTiempoBio = ahora;

            if (bioFlotante && itemsBio.length > 0) {
              const ancho = bioFlotante.clientWidth || window.innerWidth;
              const alto = bioFlotante.clientHeight || window.innerHeight;

              const margenIzq = 20;
              const margenDer = 20;
              const margenSup = 24;
              const margenInf = 24;

              for (let i = 0; i < itemsBio.length; i++) {
                const item = itemsBio[i];
                if (item.dragging) continue;

                const halfW = item.width / 2;
                const halfH = item.height / 2;
                const minX = margenIzq + halfW;
                const maxX = Math.max(minX + 10, ancho - margenDer - halfW);
                const minY = margenSup + halfH;
                const maxY = Math.max(minY + 10, alto - margenInf - halfH);

                item.x += item.vx * dt;
                item.y += item.vy * dt;

                if (item.x <= minX) {
                  if (item.x > minX - 4) item.x = minX;
                  item.vx = Math.abs(item.vx);
                } else if (item.x >= maxX) {
                  if (item.x < maxX + 4) item.x = maxX;
                  item.vx = -Math.abs(item.vx);
                }

                if (item.y <= minY) {
                  if (item.y > minY - 4) item.y = minY;
                  item.vy = Math.abs(item.vy);
                } else if (item.y >= maxY) {
                  if (item.y < maxY + 4) item.y = maxY;
                  item.vy = -Math.abs(item.vy);
                }

                aplicarPosicionBio(item);
              }
            }

            rafBio = requestAnimationFrame(paso);
          };

          rafBio = requestAnimationFrame(paso);
        };

        const estamparClonRastro = (item, x, y, listaClones) => {
          if (!bioRastro) return;

          const clon = document.createElement('div');
          clon.className = 'bio-rastro-clon';
          clon.textContent = item.texto;
          rastroZIndex = (rastroZIndex % 180) + 1;
          clon.style.zIndex = String(rastroZIndex);
          clon.style.opacity = '0.92';

          const halfW = item.width / 2;
          const halfH = item.height / 2;
          clon.style.transform = `translate3d(${x - halfW}px, ${y - halfH}px, 0)`;

          bioRastro.appendChild(clon);
          listaClones.push(clon);

          if (listaClones.length > 26) {
            const masAntiguo = listaClones.shift();
            if (masAntiguo) {
              masAntiguo.classList.add('desvanecer');
              const tElim = setTimeout(() => masAntiguo.remove(), 650);
              timersRastro.push(tElim);
            }
          }

          const total = listaClones.length;
          listaClones.forEach((elClon, idx) => {
            if (!elClon.classList.contains('desvanecer')) {
              const progreso = (idx + 1) / total;
              elClon.style.opacity = String((0.28 + progreso * 0.64).toFixed(2));
            }
          });
        };

        const ejecutarAccionBio = (item) => {
          if (item.tipo === 'enlace') {
            window.open(item.valor, '_blank', 'noopener,noreferrer');
            return;
          }

          if (item.tipo === 'email') {
            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(item.valor).then(() => {
                if (item.estadoEl) {
                  item.estadoEl.textContent = 'Copiado';
                  const rect = item.el.getBoundingClientRect();
                  if (rect.width) item.width = rect.width;
                  setTimeout(() => {
                    if (item.estadoEl) {
                      item.estadoEl.textContent = '';
                      const rectRest = item.el.getBoundingClientRect();
                      if (rectRest.width) item.width = rectRest.width;
                    }
                  }, 1500);
                }
              }).catch(() => {
                window.location.href = 'mailto:' + item.valor;
              });
            } else {
              window.location.href = 'mailto:' + item.valor;
            }
          }
        };

        const conectarInteraccionBio = (item) => {
          let inicioX = 0;
          let inicioY = 0;
          let origenX = 0;
          let origenY = 0;
          let ultimoClonX = 0;
          let ultimoClonY = 0;
          let movido = false;
          let clonesActuales = [];

          item.el.addEventListener('pointerdown', (e) => {
            if (e.button !== 0 && e.pointerType === 'mouse') return;
            e.stopPropagation();

            item.dragging = true;
            item.el.classList.add('arrastrando');
            item.el.style.zIndex = String(++activoZIndex);

            inicioX = e.clientX;
            inicioY = e.clientY;
            origenX = item.x;
            origenY = item.y;
            ultimoClonX = item.x;
            ultimoClonY = item.y;
            movido = false;
            clonesActuales = [];

            item.el.setPointerCapture(e.pointerId);
          });

          item.el.addEventListener('pointermove', (e) => {
            if (!item.dragging || !bioFlotante) return;
            e.stopPropagation();

            const dxTotal = e.clientX - inicioX;
            const dyTotal = e.clientY - inicioY;
            if (!movido && Math.hypot(dxTotal, dyTotal) > 5) {
              movido = true;
              estamparClonRastro(item, origenX, origenY, clonesActuales);
            }

            const ancho = bioFlotante.clientWidth || window.innerWidth;
            const alto = bioFlotante.clientHeight || window.innerHeight;
            const margenBordeX = Math.min(40, item.width * 0.2);
            const margenBordeY = 20;

            item.x = Math.max(margenBordeX, Math.min(ancho - margenBordeX, origenX + dxTotal));
            item.y = Math.max(margenBordeY, Math.min(alto - margenBordeY, origenY + dyTotal));
            aplicarPosicionBio(item);

            if (movido) {
              const distDesdeUltimo = Math.hypot(item.x - ultimoClonX, item.y - ultimoClonY);
              if (distDesdeUltimo >= 18) {
                estamparClonRastro(item, item.x, item.y, clonesActuales);
                ultimoClonX = item.x;
                ultimoClonY = item.y;
              }
            }
          });

          const soltar = (e) => {
            if (!item.dragging) return;
            e.stopPropagation();

            item.dragging = false;
            item.el.classList.remove('arrastrando');
            if (item.el.hasPointerCapture(e.pointerId)) {
              item.el.releasePointerCapture(e.pointerId);
