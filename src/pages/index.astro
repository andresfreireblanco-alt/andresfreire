        setTimeout(() => {
          pantallaCarga.classList.add('oculta');
          setTimeout(() => {
            pantallaCarga.style.display = 'none';
          }, 580);
        }, 780);
      }

      function iniciarDialPortada() {
        const pantalla = document.getElementById('dial-pantalla');
