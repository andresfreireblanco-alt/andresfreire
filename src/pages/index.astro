        if (!pantalla || !scriptDatos || !radios.length || !fondoA || !fondoB) return;
        if (pantalla.dataset.dialListo === '1') return;
        pantalla.dataset.dialListo = '1';

        let categorias = [];
        let contactoBio = [];
        try {
          categorias = JSON.parse(scriptDatos.textContent || '[]');
          contactoBio = scriptBio ? JSON.parse(scriptBio.textContent || '[]') : [];
        } catch {
          return;
        }
        if (!categorias.length) return;

        let indiceActivo = 0;
        let rotacionAcumulada = 0;
        let capaActual = 'a';
        let ultimaImagenMostrada = fondoA.getAttribute('src') || '';
        let bloqueoScroll = false;
        let inicioToqueY = 0;
        let musicaToken = 0;
        let rafFlotantes = null;
        let ultimoTiempoRaf = 0;
        let itemsFlotantes = [];

        // Estado específico de los elementos flotantes de Bio
        let bioToken = 0;
        let rafBio = null;
        let ultimoTiempoBio = 0;
        let itemsBio = [];
        let rastroZIndex = 1;
        let activoZIndex = 200;
        let timersRastro = [];

        const PASO_GRADOS = 22;

        // Análisis de luminancia para adaptar logo y dial al fondo
        const canvasMuestreo = document.createElement('canvas');
        canvasMuestreo.width = 48;
        canvasMuestreo.height = 48;
        const ctxMuestreo = canvasMuestreo.getContext('2d', { willReadFrequently: true });

        const calcularLuminanciaZona = (imgEl, normX, normY, normW, normH) => {
          if (!ctxMuestreo || !imgEl || !imgEl.complete || !imgEl.naturalWidth || !imgEl.naturalHeight) {
            return null;
          }

          const cw = canvasMuestreo.width;
          const ch = canvasMuestreo.height;
          const nw = imgEl.naturalWidth;
          const nh = imgEl.naturalHeight;
          const escala = Math.max(cw / nw, ch / nh);
          const drawW = nw * escala;
          const drawH = nh * escala;
          const offsetX = (cw - drawW) / 2;
          const offsetY = (ch - drawH) / 2;

          ctxMuestreo.clearRect(0, 0, cw, ch);
          try {
            ctxMuestreo.drawImage(imgEl, offsetX, offsetY, drawW, drawH);
          } catch {
            return null;
          }

          const x0 = Math.max(0, Math.min(cw - 1, Math.floor(normX * cw)));
          const y0 = Math.max(0, Math.min(ch - 1, Math.floor(normY * ch)));
          const w0 = Math.max(1, Math.min(cw - x0, Math.ceil(normW * cw)));
          const h0 = Math.max(1, Math.min(ch - y0, Math.ceil(normH * ch)));

          try {
            const datos = ctxMuestreo.getImageData(x0, y0, w0, h0).data;
            let suma = 0;
            let cuenta = 0;
            for (let i = 0; i < datos.length; i += 4) {
              const a = datos[i + 3] / 255;
              if (a <= 0.05) continue;
              const r = datos[i];
              const g = datos[i + 1];
              const b = datos[i + 2];
              const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) * a + 245 * (1 - a);
              suma += lum;
              cuenta++;
            }
            return cuenta > 0 ? suma / cuenta : null;
          } catch {
            return null;
          }
        };

        const actualizarContrasteAdaptativo = (imgActiva = null) => {
          const esModoClaroFijo = pantalla.classList.contains('modo-claro');
          if (esModoClaroFijo) {
            pantalla.classList.remove('logo-sobre-claro', 'dial-sobre-claro');
            return;
          }

          const candidata =
            imgActiva ||
            (fondoB.classList.contains('visible') ? fondoB : fondoA.classList.contains('visible') ? fondoA : null);

          if (!candidata) {
            pantalla.classList.remove('logo-sobre-claro', 'dial-sobre-claro');
            return;
          }

          const lumLogo = calcularLuminanciaZona(candidata, 0.02, 0.02, 0.24, 0.14);
          const lumDial = calcularLuminanciaZona(candidata, 0.68, 0.22, 0.3, 0.56);

          pantalla.classList.toggle('logo-sobre-claro', lumLogo !== null && lumLogo > 148);
          pantalla.classList.toggle('dial-sobre-claro', lumDial !== null && lumDial > 152);
        };

        // Devuelve horizontales en escritorio y verticales en móvil si la categoría distingue orientación
        const obtenerImagenesCategoria = (cat) => {
          if (!cat) return [];
          const esEscritorio = window.innerWidth > 768;
          if (
            esEscritorio &&
            Array.isArray(cat.imagenesDesktop) &&
            cat.imagenesDesktop.length > 0
