<div id="pantalla-transicion" class="transicion-cortina oculta sin-animacion" aria-hidden="true">
  <div class="transicion-pista">
    <div class="transicion-barra"></div>
  </div>
</div>

<style>
  .transicion-cortina {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #f8f2ef;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.55s ease;
    pointer-events: all;
  }

  .transicion-cortina.sin-animacion {
    transition: none !important;
  }

  .transicion-cortina.oculta {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .transicion-pista {
    width: 140px;
    height: 1px;
    background-color: rgba(17, 17, 17, 0.14);
    position: relative;
    overflow: hidden;
  }

  .transicion-barra {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 45%;
    background-color: #111111;
    animation: deslizar-barra 1.1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes deslizar-barra {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(240%);
    }
  }
</style>

<script is:inline>
  (function () {
    const cortina = document.getElementById('pantalla-transicion');
    if (!cortina) return;

    // Se activa siempre en la carga inicial o al recargar cualquier página,
    // pero se omite al navegar entre categorías con el encadenado interno.
    const esCargaORecarga = !window.__appCargada;
    const vieneDeTransicion = sessionStorage.getItem('transicion_inicio') === '1';

    if (esCargaORecarga || vieneDeTransicion) {
      window.__appCargada = true;
      sessionStorage.removeItem('transicion_inicio');
      cortina.classList.remove('oculta');
      void cortina.offsetHeight;
    }

    requestAnimationFrame(() => {
      cortina.classList.remove('sin-animacion');
    });

    const ocultarCortina = () => {
      const el = document.getElementById('pantalla-transicion');
      if (el) el.classList.add('oculta');
    };

    if (!cortina.classList.contains('oculta')) {
      if (document.readyState === 'complete') {
        setTimeout(ocultarCortina, 280);
      } else {
        window.addEventListener('load', () => setTimeout(ocultarCortina, 280), { once: true });
        setTimeout(ocultarCortina, 1400);
      }
    }

    if (!window.__transicionEventosRegistrados) {
      window.__transicionEventosRegistrados = true;

      window.addEventListener('pageshow', (event) => {
        if (event.persisted) ocultarCortina();
      });

      document.addEventListener(
        'click',
        (event) => {
          const enlace = event.target.closest('a');
          if (!enlace) return;

          const href = enlace.getAttribute('href');
          if (
            !href ||
            !href.startsWith('/') ||
            enlace.target === '_blank' ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          const esInicio = window.location.pathname === '/';
          const vaHaciaInicio = href === '/';

          if (!esInicio && !vaHaciaInicio) {
            return;
          }

          event.preventDefault();
          event.stopImmediatePropagation();
          sessionStorage.setItem('transicion_inicio', '1');

          const el = document.getElementById('pantalla-transicion');
          if (el) el.classList.remove('oculta');

          setTimeout(() => {
            window.location.href = href;
          }, 420);
        },
        true
      );
    }
  })();
</script>