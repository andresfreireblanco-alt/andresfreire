            if (!movido) {
              ejecutarAccionBio(item);
              return;
            }

            const copiaRastro = [...clonesActuales];
            clonesActuales = [];
            copiaRastro.forEach((clon, idx) => {
              const tFade = setTimeout(() => {
                clon.classList.add('desvanecer');
                const tRemove = setTimeout(() => clon.remove(), 680);
                timersRastro.push(tRemove);
              }, 260 + idx * 32);
              timersRastro.push(tFade);
            });
          };

          item.el.addEventListener('pointerup', soltar);
          item.el.addEventListener('pointercancel', soltar);
          item.el.addEventListener('click', (e) => e.stopPropagation());
          item.el.addEventListener('touchstart', (e) => e.stopPropagation(), { passive: true });
          item.el.addEventListener('touchend', (e) => e.stopPropagation(), { passive: true });
        };

        const ocultarBioFlotante = () => {
          bioToken += 1;
          detenerMotorBio();
          limpiarTimersRastro();
          itemsBio = [];
          if (bioFlotante) {
            bioFlotante.classList.remove('visible');
          }
          if (bioRastro) {
            bioRastro.innerHTML = '';
          }
        };

        const mostrarBioFlotante = () => {
          if (!bioFlotante || !bioActivos || !contactoBio.length) return;

          bioToken += 1;
          ultimaImagenMostrada = '';
          fondoA.classList.remove('visible');
          fondoB.classList.remove('visible');
          actualizarContrasteAdaptativo(null);

          detenerMotorBio();
          limpiarTimersRastro();
          if (bioRastro) bioRastro.innerHTML = '';
          bioActivos.innerHTML = '';
          itemsBio = [];
          rastroZIndex = 1;
          activoZIndex = 200;

          const ancho = bioFlotante.clientWidth || window.innerWidth;
          const alto = bioFlotante.clientHeight || window.innerHeight;
          const esMovil = ancho <= 768;

          const slotsBio = esMovil
            ? [
                { x: 28, y: 18, vx: 3.1, vy: 2.0 },
                { x: 68, y: 24, vx: -2.8, vy: 2.3 },
                { x: 34, y: 37, vx: 2.9, vy: -2.1 },
                { x: 64, y: 46, vx: -3.2, vy: 1.9 },
                { x: 26, y: 58, vx: 3.3, vy: -2.2 },
                { x: 66, y: 67, vx: -2.7, vy: -2.4 },
                { x: 35, y: 79, vx: 2.8, vy: -2.0 },
                { x: 62, y: 88, vx: -3.0, vy: -2.3 },
              ]
            : [
                { x: 16, y: 17, vx: 3.6, vy: 2.1 },
                { x: 46, y: 14, vx: -3.1, vy: 2.5 },
                { x: 76, y: 20, vx: -3.5, vy: 1.9 },
                { x: 24, y: 37, vx: 3.2, vy: -2.3 },
                { x: 56, y: 41, vx: -2.9, vy: 2.4 },
                { x: 84, y: 38, vx: -3.4, vy: -2.0 },
                { x: 15, y: 61, vx: 3.5, vy: -2.2 },
                { x: 44, y: 65, vx: 2.8, vy: -2.6 },
                { x: 74, y: 59, vx: -3.3, vy: 2.3 },
                { x: 26, y: 83, vx: 3.1, vy: -2.4 },
                { x: 55, y: 86, vx: -3.6, vy: -2.1 },
                { x: 82, y: 81, vx: -2.8, vy: -2.5 },
              ];

          slotsBio.forEach((posCfg, i) => {
            const dato = contactoBio[i % contactoBio.length];
            const slot = document.createElement('div');
            slot.className = 'bio-slot';
            slot.style.zIndex = String(activoZIndex + i);

            const pildora = document.createElement('div');
            pildora.className = 'bio-pildora';
            pildora.style.setProperty('--enter-delay', `${i * 35}ms`);

            const textoSpan = document.createElement('span');
            textoSpan.textContent = dato.texto;
            pildora.appendChild(textoSpan);

            let estadoEl = null;
            if (dato.tipo === 'email') {
              estadoEl = document.createElement('span');
              estadoEl.className = 'bio-estado-copia';
              pildora.appendChild(estadoEl);
            }

            slot.appendChild(pildora);
            bioActivos.appendChild(slot);

            const rect = slot.getBoundingClientRect();
            const jitterX = (Math.random() - 0.5) * 2.5;
            const jitterY = (Math.random() - 0.5) * 2.5;
            const factorVel = 0.85 + Math.random() * 0.3;

            const item = {
              el: slot,
              estadoEl,
              texto: dato.texto,
              tipo: dato.tipo,
              valor: dato.valor,
              width: rect.width || (esMovil ? 190 : 240),
              height: rect.height || 36,
              x: ((posCfg.x + jitterX) / 100) * ancho,
              y: ((posCfg.y + jitterY) / 100) * alto,
              vx: posCfg.vx * factorVel,
              vy: posCfg.vy * factorVel,
              dragging: false,
            };

            aplicarPosicionBio(item);
            conectarInteraccionBio(item);
            itemsBio.push(item);
          });

          activoZIndex += slotsBio.length;
          void bioFlotante.offsetWidth;
          bioFlotante.classList.add('visible');
          iniciarMotorBio();
        };

        const elegirImagenAleatoria = (lista) => {
          if (!lista || !lista.length) return '';
          if (lista.length === 1) return lista[0];
          const candidatas = lista.filter((src) => src !== ultimaImagenMostrada);
          const pool = candidatas.length > 0 ? candidatas : lista;
          return pool[Math.floor(Math.random() * pool.length)];
        };

        const cambiarFondo = (nuevaSrc) => {
          ocultarMusicaFlotante();
          ocultarBioFlotante();

          if (!nuevaSrc) {
            ultimaImagenMostrada = '';
            fondoA.classList.remove('visible');
            fondoB.classList.remove('visible');
            actualizarContrasteAdaptativo(null);
            return;
          }

          if (nuevaSrc === ultimaImagenMostrada) return;
          ultimaImagenMostrada = nuevaSrc;

          const entrante = capaActual === 'a' ? fondoB : fondoA;
          const saliente = capaActual === 'a' ? fondoA : fondoB;
          capaActual = capaActual === 'a' ? 'b' : 'a';

          const precarga = new Image();
          precarga.onload = () => {
            entrante.src = nuevaSrc;
            requestAnimationFrame(() => {
              entrante.classList.add('visible');
              saliente.classList.remove('visible');
              actualizarContrasteAdaptativo(entrante);
            });
          };
          precarga.src = nuevaSrc;
        };

        // Ajusta la foto inicial de Fotografía si se entra directamente desde móvil
        const listaArranque = obtenerImagenesCategoria(categorias[0]);
        if (listaArranque.length > 0 && !listaArranque.includes(ultimaImagenMostrada)) {
          const fotoMovilInicial = elegirImagenAleatoria(listaArranque);
          if (fotoMovilInicial) {
            ultimaImagenMostrada = fotoMovilInicial;
            fondoA.src = fotoMovilInicial;
          }
        }

        if (fondoA.complete && fondoA.naturalWidth) {
          actualizarContrasteAdaptativo(fondoA);
        } else {
          fondoA.addEventListener('load', () => actualizarContrasteAdaptativo(fondoA), { once: true });
        }

        const actualizarDial = (nuevoIndice, forzarNuevaFoto = true) => {
          const total = categorias.length;
          const normalizado = ((nuevoIndice % total) + total) % total;

          let delta = normalizado - indiceActivo;
          if (delta > total / 2) delta -= total;
          if (delta < -total / 2) delta += total;
          rotacionAcumulada += delta * PASO_GRADOS;

          indiceActivo = normalizado;
          const cat = categorias[indiceActivo];
          const listaImagenes = obtenerImagenesCategoria(cat);
          const sinImagenes = !listaImagenes || listaImagenes.length === 0;

          pantalla.classList.toggle(
            'modo-claro',
            Boolean(cat.flotante) || Boolean(cat.bioFlotante) || sinImagenes
          );
          actualizarContrasteAdaptativo();

          if (anilloMuescas) {
            anilloMuescas.style.transform = `rotate(${rotacionAcumulada}deg)`;
          }

          radios.forEach((radio, idx) => {
            let dif = idx - indiceActivo;
            if (dif > total / 2) dif -= total;
            if (dif < -total / 2) dif += total;

            const angulo = -dif * PASO_GRADOS;
            radio.style.transform = `rotate(${angulo}deg)`;
            radio.classList.toggle('activo', idx === indiceActivo);

            const enlace = radio.querySelector('.dial-opcion');
            if (enlace) {
              if (idx === indiceActivo) {
                enlace.setAttribute('aria-current', 'page');
              } else {
                enlace.removeAttribute('aria-current');
              }
            }
          });

          if (forzarNuevaFoto) {
            if (cat.flotante) {
              ocultarBioFlotante();
              mostrarMusicaFlotante(listaImagenes);
            } else if (cat.bioFlotante) {
              ocultarMusicaFlotante();
              mostrarBioFlotante();
            } else {
              const aleatoria = elegirImagenAleatoria(listaImagenes);
              cambiarFondo(aleatoria);
            }
          }
        };

        radios.forEach((radio) => {
          const enlace = radio.querySelector('.dial-opcion');
          if (!enlace) return;

          enlace.addEventListener('click', (e) => {
            e.stopPropagation();
            const idx = Number(enlace.getAttribute('data-index'));

            if (idx !== indiceActivo) {
              e.preventDefault();
              actualizarDial(idx, true);
            }
          });
        });

        if (fondoContenedor) {
          fondoContenedor.addEventListener('click', () => {
            const cat = categorias[indiceActivo];
            if (cat.bioFlotante) {
              mostrarBioFlotante();
              return;
            }
            const listaImagenes = obtenerImagenesCategoria(cat);
            if (!listaImagenes || listaImagenes.length === 0) return;
            if (cat.flotante) {
              mostrarMusicaFlotante(listaImagenes);
            } else {
              const aleatoria = elegirImagenAleatoria(listaImagenes);
              cambiarFondo(aleatoria);
            }
          });
        }

        // Si cambia la orientación o el ancho de ventana en Fotografía, adapta la imagen al formato
        window.addEventListener('resize', () => {
          const cat = categorias[indiceActivo];
          if (!cat || cat.flotante || cat.bioFlotante) return;
          const listaActual = obtenerImagenesCategoria(cat);
          if (listaActual.length > 0 && !listaActual.includes(ultimaImagenMostrada)) {
            cambiarFondo(elegirImagenAleatoria(listaActual));
          } else {
            actualizarContrasteAdaptativo();
          }
        });

        pantalla.addEventListener(
          'wheel',
          (e) => {
            e.preventDefault();
            if (bloqueoScroll) return;
            if (Math.abs(e.deltaY) < 8) return;

            bloqueoScroll = true;
            const direccion = e.deltaY > 0 ? 1 : -1;
            actualizarDial(indiceActivo + direccion, true);

            setTimeout(() => {
              bloqueoScroll = false;
            }, 260);
          },
          { passive: false }
        );

        pantalla.addEventListener(
          'touchstart',
          (e) => {
            if (e.touches.length === 1) {
              inicioToqueY = e.touches[0].clientY;
            }
          },
          { passive: true }
        );

        pantalla.addEventListener(
          'touchend',
          (e) => {
            if (!e.changedTouches.length) return;
            const deltaY = inicioToqueY - e.changedTouches[0].clientY;
            if (Math.abs(deltaY) > 35) {
              const direccion = deltaY > 0 ? 1 : -1;
              actualizarDial(indiceActivo + direccion, true);
            }
          },
          { passive: true }
        );

        pantalla.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
            e.preventDefault();
            actualizarDial(indiceActivo + 1, true);
          } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
            e.preventDefault();
            actualizarDial(indiceActivo - 1, true);
          } else if (e.key === 'Enter') {
            const enlaceActivo = radios[indiceActivo]?.querySelector('.dial-opcion');
            if (enlaceActivo) {
              e.preventDefault();
              enlaceActivo.click();
            }
          }
        });
      }

      if (!window.__dialPortadaRegistrado) {
        window.__dialPortadaRegistrado = true;

        document.addEventListener('astro:before-preparation', () => {
          window.__navegacionInterna = true;
        });

        document.addEventListener('astro:after-swap', () => {
          if (window.__navegacionInterna) {
            const cortina = document.getElementById('inicio-pantalla-carga');
            if (cortina) cortina.style.display = 'none';
          }
        });

        document.addEventListener('astro:page-load', () => {
          iniciarPantallaCarga();
          iniciarDialPortada();
        });
      }

      iniciarPantallaCarga();
      iniciarDialPortada();
    </script>
  </body>
</html>