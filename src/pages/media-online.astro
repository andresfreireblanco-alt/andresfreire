---

<BaseLayout titulo="Andrés Freire — Media online">
  <div class="media-contenedor">
    <section class="media-rejilla">
      {piezas.map((pieza) => (
        <article class="media-item">
          <div class:list={['media-marco', `formato-${pieza.formato}`]}>
            {pieza.enlaceEmbed ? (
              <iframe
                src={pieza.enlaceEmbed}
                title={pieza.titulo}
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            ) : pieza.enlaceExterno ? (
              <a href={pieza.enlaceExterno} target="_blank" rel="noopener" class="media-enlace">
                <img src={pieza.miniatura} alt={pieza.titulo} loading="lazy" />
              </a>
            ) : (
              <img src={pieza.miniatura} alt={pieza.titulo} loading="lazy" />
            )}
          </div>

          <div class="media-meta">
            <div class="media-cabecera-item">
              <p class="media-titulo">{pieza.titulo}</p>
              <strong class="media-año">{pieza.año}</strong>
            </div>
            <p class="media-subtitulo">{pieza.etiqueta}</p>
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .media-contenedor {
    width: 100%;
    max-width: 920px;
  }

  .media-rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2.5rem 2rem;
    align-items: start;
  }

  .media-marco {
    width: 100%;
    background-color: rgba(17, 17, 17, 0.04);
    overflow: hidden;
  }

  .media-marco.formato-horizontal {
    aspect-ratio: 16 / 9;
  }

  .media-marco.formato-vertical {
    aspect-ratio: 9 / 16;
    max-width: 280px;
  }

  .media-marco.formato-cuadrado {
    aspect-ratio: 1 / 1;
  }

  .media-marco iframe,
  .media-marco img {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-enlace:hover img {
    transform: scale(1.02);
  }

  .media-meta {
    margin-top: 0.75rem;
  }

  .media-cabecera-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 13px;
    color: var(--texto, #111111);
  }

  .media-titulo {
    margin: 0;
    font-weight: 500;
  }

  .media-año {
    color: #111111;
    font-weight: 700;
    flex-shrink: 0;
  }

  .media-subtitulo {
    margin: 0.2rem 0 0;
    font-size: 12px;
    color: var(--texto-suave, #767676);
  }
</style>