            return cat.imagenesDesktop;
          }
          return Array.isArray(cat.imagenes) ? cat.imagenes : [];
        };

        // Precargamos y decodificamos en segundo plano todas las portadas de Música
        const cacheDecodificadas = new Map();
        const precargarYDecodificar = (src) => {
          if (!src) return Promise.resolve();
          if (cacheDecodificadas.has(src)) return cacheDecodificadas.get(src);

          const promesa = new Promise((resolve) => {
            const img = new Image();
            img.onload = () => {
              if (typeof img.decode === 'function') {
                img.decode().then(resolve).catch(resolve);
              } else {
                resolve();
              }
            };
            img.onerror = resolve;
            img.src = src;
          });

          cacheDecodificadas.set(src, promesa);
          return promesa;
        };

        const catMusica = categorias.find((c) => c.flotante);
        if (catMusica && Array.isArray(catMusica.imagenes)) {
          catMusica.imagenes.forEach((src) => precargarYDecodificar(src));
        }

        // Posiciones iniciales repartidas por el lienzo para Música
        const SLOTS_FLOTANTES = [
          { x: 22, y: 28, size: 'clamp(115px, 11vw, 165px)', mx: 22, my: 24, msize: '90px' },
          { x: 16, y: 60, size: 'clamp(135px, 14vw, 200px)', mx: 38, my: 38, msize: '104px' },
          { x: 41, y: 46, size: 'clamp(145px, 15vw, 220px)', mx: 20, my: 54, msize: '110px' },
          { x: 31, y: 76, size: 'clamp(105px, 10.5vw, 150px)', mx: 38, my: 70, msize: '92px' },
          { x: 55, y: 26, size: 'clamp(100px, 10vw, 145px)', mx: 22, my: 84, msize: '84px' },
          { x: 56, y: 70, size: 'clamp(120px, 12vw, 175px)', mx: 36, my: 85, msize: '84px' },
        ];

        const barajar = (lista) => {
          const copia = [...lista];
          for (let i = copia.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copia[i], copia[j]] = [copia[j], copia[i]];
          }
          return copia;
        };

        const detenerMotorViaje = () => {
          if (rafFlotantes) {
            cancelAnimationFrame(rafFlotantes);
            rafFlotantes = null;
          }
        };

        const aplicarPosicionItem = (item) => {
          const halfW = item.size / 2;
          item.el.style.transform = `translate3d(${item.x - halfW}px, ${item.y - halfW}px, 0)`;
        };

        const iniciarMotorViaje = () => {
          detenerMotorViaje();
          ultimoTiempoRaf = performance.now();

          const paso = (ahora) => {
            const dt = Math.min((ahora - ultimoTiempoRaf) / 1000, 0.05);
            ultimoTiempoRaf = ahora;

            if (musicaFlotante && itemsFlotantes.length > 0) {
              const ancho = musicaFlotante.clientWidth || window.innerWidth;
              const alto = musicaFlotante.clientHeight || window.innerHeight;
              const esMovil = ancho <= 768;

              const margenIzq = 24;
              const margenDer = esMovil ? 165 : 250;
              const margenSup = esMovil ? 74 : 96;
              const margenInf = 24;

              for (let i = 0; i < itemsFlotantes.length; i++) {
                const item = itemsFlotantes[i];
                if (item.dragging) continue;

                const half = item.size / 2;
                const minX = margenIzq + half;
                const maxX = Math.max(minX + 10, ancho - margenDer - half);
                const minY = margenSup + half;
                const maxY = Math.max(minY + 10, alto - margenInf - half);

                item.x += item.vx * dt;
                item.y += item.vy * dt;

                if (item.x <= minX) {
                  if (item.x > minX - 4) item.x = minX;
                  item.vx = Math.abs(item.vx);
                } else if (item.x >= maxX) {
                  if (item.x < maxX + 4) item.x = maxX;
                  item.vx = -Math.abs(item.vx);
                }

                if (item.y <= minY) {
                  if (item.y > minY - 4) item.y = minY;
                  item.vy = Math.abs(item.vy);
                } else if (item.y >= maxY) {
                  if (item.y < maxY + 4) item.y = maxY;
                  item.vy = -Math.abs(item.vy);
                }

                aplicarPosicionItem(item);
              }
            }

            rafFlotantes = requestAnimationFrame(paso);
          };

          rafFlotantes = requestAnimationFrame(paso);
        };

        const conectarArrastre = (item) => {
          let inicioX = 0;
          let inicioY = 0;
          let origenX = 0;
          let origenY = 0;

          item.el.addEventListener('pointerdown', (e) => {
            if (e.button !== 0 && e.pointerType === 'mouse') return;
            e.stopPropagation();

            item.dragging = true;
            item.el.classList.add('arrastrando');
            inicioX = e.clientX;
            inicioY = e.clientY;
            origenX = item.x;
            origenY = item.y;
            item.el.setPointerCapture(e.pointerId);
          });

          item.el.addEventListener('pointermove', (e) => {
            if (!item.dragging) return;
            e.stopPropagation();

            const ancho = musicaFlotante.clientWidth || window.innerWidth;
            const alto = musicaFlotante.clientHeight || window.innerHeight;
            const margenBorde = item.size * 0.25;

            item.x = Math.max(margenBorde, Math.min(ancho - margenBorde, origenX + (e.clientX - inicioX)));
            item.y = Math.max(margenBorde, Math.min(alto - margenBorde, origenY + (e.clientY - inicioY)));
            aplicarPosicionItem(item);
          });

          const soltar = (e) => {
            if (!item.dragging) return;
            e.stopPropagation();
            item.dragging = false;
            item.el.classList.remove('arrastrando');
            if (item.el.hasPointerCapture(e.pointerId)) {
              item.el.releasePointerCapture(e.pointerId);
            }
          };

          item.el.addEventListener('pointerup', soltar);
          item.el.addEventListener('pointercancel', soltar);
          item.el.addEventListener('click', (e) => e.stopPropagation());
          item.el.addEventListener('touchstart', (e) => e.stopPropagation(), { passive: true });
          item.el.addEventListener('touchend', (e) => e.stopPropagation(), { passive: true });
        };

        const ocultarMusicaFlotante = () => {
          musicaToken += 1;
          detenerMotorViaje();
          itemsFlotantes = [];
          if (musicaFlotante) {
            musicaFlotante.classList.remove('visible');
          }
        };

        const mostrarMusicaFlotante = async (lista) => {
          if (!musicaFlotante || !lista || !lista.length) return;

          const tokenActual = ++musicaToken;
          ultimaImagenMostrada = '';
          fondoA.classList.remove('visible');
          fondoB.classList.remove('visible');
          actualizarContrasteAdaptativo(null);

          const yaVisible = musicaFlotante.classList.contains('visible');
          if (yaVisible) {
            musicaFlotante.classList.remove('visible');
          }

          const elegidas = barajar(lista).slice(0, SLOTS_FLOTANTES.length);

          await Promise.all([
            ...elegidas.map((src) => precargarYDecodificar(src)),
            yaVisible ? new Promise((r) => setTimeout(r, 260)) : Promise.resolve(),
          ]);

          if (tokenActual !== musicaToken) return;

          detenerMotorViaje();
          musicaFlotante.innerHTML = '';
          itemsFlotantes = [];

          const ancho = musicaFlotante.clientWidth || window.innerWidth;
          const alto = musicaFlotante.clientHeight || window.innerHeight;
          const esMovil = ancho <= 768;

          const anguloBase = Math.random() * Math.PI * 2;
          const pasoAngulo = (Math.PI * 2) / elegidas.length;

          elegidas.forEach((src, i) => {
            const slotCfg = SLOTS_FLOTANTES[i];
            const slot = document.createElement('div');
            slot.className = 'flotante-slot';
            slot.style.setProperty('--size', slotCfg.size);
            slot.style.setProperty('--msize', slotCfg.msize);
            slot.style.zIndex = String(i + 1);

            const carta = document.createElement('div');
            carta.className = 'flotante-carta';
