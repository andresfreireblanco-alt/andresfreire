        const scriptBio = document.getElementById('dial-bio-json');
        const anilloMuescas = document.getElementById('dial-anillo-muescas');
        const radios = Array.from(document.querySelectorAll('.dial-radio'));
        const fondoA = document.getElementById('dial-fondo-a');
