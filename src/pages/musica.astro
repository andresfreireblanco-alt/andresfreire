---

<BaseLayout titulo="Andrés Freire — Música">
  <div class="perfil-musical">

    <!-- Resumen superior con cifra global -->
    <header class="cabecera-musical">
      <div class="metrica">
        <span class="metrica-numero">{streamsTotales}</span>
        <span class="metrica-etiqueta">Streams</span>
      </div>
      <div class="metrica">
        <span class="metrica-numero">{canciones.length}</span>
        <span class="metrica-etiqueta">Créditos</span>
      </div>
      <div class="metrica">
        <span class="metrica-numero">{artistas.length}</span>
        <span class="metrica-etiqueta">Artistas</span>
      </div>
    </header>

    <!-- Pestañas -->
    <nav class="pestanas">
      <button type="button" class="pestana-btn activa" data-objetivo="panel-trabajos">Trabajos</button>
      <button type="button" class="pestana-btn" data-objetivo="panel-artistas">Artistas</button>
    </nav>

    <!-- PESTAÑA 1: Carátulas limpias sin cifras individuales -->
    <section id="panel-trabajos" class="panel-contenido visible">
      <div class="rejilla-discos">
        {canciones.map((cancion) => (
          <a href={cancion.enlace} target="_blank" rel="noopener" class="tarjeta-disco">
            <div class="caratura-marco">
              <img src={cancion.portada} alt={cancion.titulo} loading="lazy" />
            </div>
            <div class="disco-datos">
              <div class="disco-cabecera">
                <p class="disco-titulo">{cancion.titulo}</p>
                <strong class="disco-año">{cancion.año}</strong>
              </div>
              <p class="disco-artista">{cancion.artista}</p>
              <div class="disco-pie">
                <span>{cancion.rol}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- PESTAÑA 2: Artistas -->
    <section id="panel-artistas" class="panel-contenido">
      <div class="lista-artistas">
        {artistas.map((artista) => (
          <a href={artista.enlace} target="_blank" rel="noopener" class="fila-artista">
            <div>
              <p class="artista-nombre">{artista.nombre}</p>
              <p class="texto-secundario">{artista.rol}</p>
            </div>
            <span class="texto-secundario artista-cantidad">
              {artista.cantidad}
              <svg
                class="artista-flecha"
                width="11"
                height="11"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 9L9 3M9 3H4M9 3V8"
                  stroke="currentColor"
                  stroke-width="1.15"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .disco-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .disco-año {
    color: #111111;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }

  .artista-cantidad {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .artista-flecha {
    display: inline-block;
    flex-shrink: 0;
    opacity: 0.75;
  }
</style>

<script is:inline>
  function iniciarPestanasMusica() {
    const contenedor = document.querySelector('.perfil-musical');
    if (!contenedor || contenedor.dataset.pestanasListas === '1') return;
    contenedor.dataset.pestanasListas = '1';

    const botones = contenedor.querySelectorAll('.pestana-btn');
    const paneles = contenedor.querySelectorAll('.panel-contenido');

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        botones.forEach((b) => b.classList.remove('activa'));
        paneles.forEach((p) => p.classList.remove('visible'));

        boton.classList.add('activa');
        const idDestino = boton.getAttribute('data-objetivo');
        if (idDestino) {
          document.getElementById(idDestino)?.classList.add('visible');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', iniciarPestanasMusica);
  iniciarPestanasMusica();
</script>